{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opal",
  "version": "0.1.0",
  "identifier": "dev.opal.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Glass widgets on the Windows wallpaper",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
